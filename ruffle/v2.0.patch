+/// Identify anonymous configuration records with sequential numeric object
+/// rows and textual named metadata. Keep metadata enumerable, but out of the
+/// row bucket layout so it cannot shuffle the order of the numeric records.
+fn is_numbered_record(elements: &[Element]) -> bool {
+    let mut row_count = 0;
+    let mut has_metadata = false;
+    let mut first = u32::MAX;
+    let mut last = 0;
+
+    for entry in elements {
+        if let Some(index) =
+            parse_u32_index(WStr::from_units(entry.name().as_bytes()), (1 << 28) - 1)
+        {
+            if !matches!(
+                entry.value(),
+                AmfValue::Object(..) | AmfValue::Amf3ObjectReference(_)
+            ) {
+                return false;
+            }
+            first = first.min(index);
+            last = last.max(index);
+            row_count += 1;
+        } else if matches!(entry.value(), AmfValue::String(_)) {
+            has_metadata = true;
+        } else {
+            return false;
+        }
+    }
+
+    has_metadata && first <= 1 && (last - first + 1) as usize == row_count
+}
