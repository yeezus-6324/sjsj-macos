+fn decode_bitmap_data_from_symbol<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    symbol: &BitmapCharacter<'gc>,
+    class: crate::avm2::QName<'gc>,
+) -> Result<(ruffle_render::bitmap::BitmapSize, BitmapPixels), Error<'gc>> {
+    let bitmap = symbol.compressed().decode().map_err(|error| {
+        tracing::error!("Failed to decode embedded BitmapData: {error}");
+        make_error_2015(activation)
+    })?;
+    let (width, height) = (bitmap.width(), bitmap.height());
+    let format = bitmap.format();
+    let mut bytes = bitmap.into_buf().into_owned();
+    if format == ruffle_render::bitmap::BitmapFormat::Rgb {
+        let pixels = bytes.len() / 3;
+        bytes.try_reserve_exact(pixels).map_err(|error| {
+            tracing::error!("Failed to expand embedded BitmapData ({width}x{height}): {error}");
+            make_error_2015(activation)
+        })?;
+        bytes.resize(pixels * 4, 0);
+        for index in (0..pixels).rev() {
+            let from = index * 3;
+            let to = index * 4;
+            let rgba = [bytes[from], bytes[from + 1], bytes[from + 2], 255];
+            bytes[to..to + 4].copy_from_slice(&rgba);
+        }
+    } else {
+        debug_assert_eq!(format, ruffle_render::bitmap::BitmapFormat::Rgba);
+    }
+    // Color is four byte-aligned RGBA channels. The allocator layout matches
+    // once the byte vector capacity is divisible by the size of one pixel.
+    let pixels = match bytemuck::allocation::try_cast_vec::<u8, Color>(bytes) {
+        Ok(pixels) => pixels,
+        Err((_, bytes)) => {
+            let mut pixels = Vec::new();
+            pixels.try_reserve_exact(bytes.len() / 4).map_err(|error| {
+                tracing::error!("Failed to allocate embedded BitmapData ({width}x{height}): {error}");
+                make_error_2015(activation)
+            })?;
+            pixels.extend_from_slice(bytemuck::cast_slice(&bytes));
+            pixels
+        }
+    };
+    let pixels = BitmapPixels::from_embedded(pixels);
+    pixels.record_embedded_class(class);
+    Ok((ruffle_render::bitmap::BitmapSize { width, height }, pixels))
 }
 
