+/// Keys represented as unsigned integer atoms have a predictable placement in
+/// Flash's dynamic property table. Reference-backed keys depend on object
+/// addresses, so keep the ordinary enumeration for tables containing those.
+pub trait NumericAtomKey: Sized {
+    fn numeric_atom(&self) -> Option<u32>;
+    fn from_numeric_atom(index: u32) -> Self;
+}
+
+impl NumericAtomKey for DynamicKey<'_> {
+    fn numeric_atom(&self) -> Option<u32> {
+        match self {
+            Self::Uint(index) => Some(*index),
+            _ => None,
+        }
+    }
+
+    fn from_numeric_atom(index: u32) -> Self {
+        Self::Uint(index)
+    }
+}
+
+#[derive(Debug, Clone, Copy)]
+enum NumericBucket {
+    Empty,
+    Deleted,
+    Key(u32),
+}
+
+#[derive(Debug, Clone)]
+struct NumericBuckets {
+    buckets: Vec<NumericBucket>,
+    occupied: usize,
+    deleted: usize,
+}
+
+impl NumericBuckets {
+    fn new() -> Self {
+        Self {
+            buckets: vec![NumericBucket::Empty; 2],
+            occupied: 0,
+            deleted: 0,
+        }
+    }
+
+    fn find(&self, key: u32) -> usize {
+        let mask = self.buckets.len() - 1;
+        let mut index = (key & 0x0fff_ffff) as usize & mask;
+        // Successive probes use increasing displacements starting at eight.
+        for displacement in 8.. {
+            match self.buckets[index] {
+                NumericBucket::Empty => break,
+                NumericBucket::Key(stored) if stored == key => break,
+                _ => index = (index + displacement) & mask,
+            }
+        }
+        index
+    }
+
+    fn insert(&mut self, key: u32) {
+        let index = self.find(key);
+        self.buckets[index] = NumericBucket::Key(key);
+        // Flash rehashes at this load factor, reclaiming tombstones before
+        // increasing capacity. Reinsert in old bucket order.
+        self.occupied += 1;
+        if 5 * (self.occupied + 1) >= 4 * self.buckets.len() {
+            let capacity = if self.deleted == 0 {
+                self.buckets.len() * 2
+            } else {
+                self.buckets.len()
+            };
+            let old = std::mem::replace(&mut self.buckets, vec![NumericBucket::Empty; capacity]);
+            self.occupied -= self.deleted;
+            self.deleted = 0;
+            for bucket in old {
+                if let NumericBucket::Key(key) = bucket {
+                    let index = self.find(key);
+                    self.buckets[index] = bucket;
+                }
+            }
+        }
+    }
+
+    fn remove(&mut self, key: u32) {
+        let index = self.find(key);
+        debug_assert!(matches!(self.buckets[index], NumericBucket::Key(stored) if stored == key));
+        self.buckets[index] = NumericBucket::Deleted;
+        self.deleted += 1;
+    }
+}
+
+#[derive(Debug, Clone, Default)]
+enum EnumerationBuckets {
+    #[default]
+    Empty,
+    Numeric(Box<NumericBuckets>),
+    NumberedRecord(Box<NumericBuckets>),
+    General,
+}
