+    // sampling region and avoid an input copy or a floating-point image.
+    let boundary = |index: u32, source_size: u32, target_size: u32| {
+        (u64::from(index) * u64::from(source_size) / u64::from(target_size)) as usize
+    };
+    for y in 0..new_height {
