+pub fn embedded_bitmap_class_summary() -> String {
+    EMBEDDED_PIXEL_CLASSES.with_borrow_mut(|entries| {
+        let mut totals = HashMap::new();
+        entries.retain(|_, (name, pixels)| {
+            if let Some(pixels) = pixels.upgrade() {
+                let bytes = pixels.capacity() * size_of::<Color>();
+                if bytes != 0 {
+                    *totals.entry(name.as_str().to_owned()).or_insert(0usize) += bytes;
+                }
+                true
+            } else {
+                false
+            }
+        });
+        let mut rows: Vec<_> = totals.into_iter().collect();
+        rows.sort_unstable_by(|(a_name, a_size), (b_name, b_size)| {
+            b_size.cmp(a_size).then_with(|| a_name.cmp(b_name))
+        });
+        let tracked: usize = rows.iter().map(|(_, bytes)| bytes).sum();
+        rows.truncate(24);
+        serde_json::json!({
+            "tracked_bytes": tracked,
+            "classes": rows,
+            "packed_bytes": PACKED_PIXEL_BYTES.load(Relaxed),
+            "packed_buffers": PACKED_PIXEL_BUFFERS.load(Relaxed),
+            "packed_restores": PACKED_PIXEL_RESTORES.load(Relaxed),
+        }).to_string()
+    })
+}
