+const MIN_COLD_PIXEL_BYTES: usize = 512 * 1024;
+const MAX_COLD_PIXEL_BYTES: usize = 8 * 1024 * 1024;
+const COLD_SECONDS: usize = 20;
+const MIN_EMBEDDED_PRESSURE_BYTES: usize = 128 * 1024 * 1024;
+static PACKED_PIXEL_BYTES: AtomicUsize = AtomicUsize::new(0);
+static PACKED_PIXEL_BUFFERS: AtomicUsize = AtomicUsize::new(0);
+static PACKED_PIXEL_RESTORES: AtomicUsize = AtomicUsize::new(0);
+
+thread_local! {
+    static PIXEL_CLOCK: Cell<usize> = const { Cell::new(0) };
+}
+
+pub(crate) fn set_cold_bitmap_clock(seconds: usize) -> bool {
+    PIXEL_CLOCK.set(seconds);
+    BITMAP_BYTES_BY_ORIGIN[PixelOrigin::Embedded as usize].load(Relaxed)
+        >= MIN_EMBEDDED_PRESSURE_BYTES
+}
+
+struct PackedPixels {
+    bytes: Vec<u8>,
+    len: usize,
+}
+
+impl PackedPixels {
+    fn encode(raw: &[Color]) -> Option<Self> {
+        let input = Color::slice_as_rgba(raw);
+        let mut bytes = Vec::new();
+        // Give up if we cannot save at least half of the decoded allocation.
+        bytes.try_reserve_exact(input.len() / 2).ok()?;
+        let mut encoder = Compress::new(Compression::fast(), false);
+        let status = encoder.compress_vec(input, &mut bytes, FlushCompress::Finish).ok()?;
+        if status != Status::StreamEnd || encoder.total_in() != input.len() as u64 {
+            return None;
+        }
+        bytes.shrink_to_fit();
+        PACKED_PIXEL_BYTES.fetch_add(bytes.capacity(), Relaxed);
+        PACKED_PIXEL_BUFFERS.fetch_add(1, Relaxed);
+        Some(Self { bytes, len: raw.len() })
+    }
+
+    fn decode(&self) -> Vec<Color> {
+        let mut colors = vec![Color::default(); self.len];
+        let output = bytemuck::cast_slice_mut(&mut colors);
+        let mut decoder = Decompress::new(false);
+        let status = decoder
+            .decompress(&self.bytes, output, FlushDecompress::Finish)
+            .expect("Internally compressed BitmapData must decode");
+        assert_eq!(status, Status::StreamEnd);
+        assert_eq!(decoder.total_out(), output.len() as u64);
+        assert_eq!(decoder.total_in(), self.bytes.len() as u64);
+        PACKED_PIXEL_RESTORES.fetch_add(1, Relaxed);
+        colors
+    }
+}
+
+impl Drop for PackedPixels {
+    fn drop(&mut self) {
+        PACKED_PIXEL_BYTES.fetch_sub(self.bytes.capacity(), Relaxed);
+        PACKED_PIXEL_BUFFERS.fetch_sub(1, Relaxed);
+    }
+}
+
+#[derive(Default)]
+struct PixelBuffer {
+    raw: OnceLock<Vec<Color>>,
+    packed: Option<Arc<PackedPixels>>,
+    origin: PixelOrigin,
+    last_access: AtomicUsize,
+    packing_rejected: AtomicBool,
+}
+
+impl PixelBuffer {
+    fn new(pixels: Vec<Color>, origin: PixelOrigin) -> Self {
+        BITMAP_BYTES_BY_ORIGIN[origin as usize]
+            .fetch_add(pixels.capacity() * size_of::<Color>(), Relaxed);
+        Self {
+            raw: OnceLock::from(pixels),
+            origin,
+            last_access: AtomicUsize::new(PIXEL_CLOCK.get()),
+            packed: None,
+            packing_rejected: AtomicBool::new(false),
+        }
+    }
+
+    fn touch(&self) {
+        if matches!(self.origin, PixelOrigin::Embedded) {
+            self.last_access.store(PIXEL_CLOCK.get(), Relaxed);
+        }
+    }
+
+    fn colors(&self) -> &[Color] {
+        self.touch();
+        self.raw.get_or_init(|| {
+            let Some(packed) = &self.packed else {
+                return Vec::new();
+            };
+            let pixels = packed.decode();
+            BITMAP_BYTES_BY_ORIGIN[self.origin as usize]
+                .fetch_add(pixels.capacity() * size_of::<Color>(), Relaxed);
+            pixels
+        })
+    }
+
+    fn capacity(&self) -> usize {
+        self.raw.get().map_or(0, Vec::capacity)
+    }
+}
+
+impl Clone for PixelBuffer {
+    fn clone(&self) -> Self {
+        Self::new(self.colors().to_vec(), PixelOrigin::CopyOnWrite)
+    }
+}
+
+impl Drop for PixelBuffer {
+    fn drop(&mut self) {
+        BITMAP_BYTES_BY_ORIGIN[self.origin as usize]
+            .fetch_sub(self.capacity() * size_of::<Color>(), Relaxed);
+    }
+}
