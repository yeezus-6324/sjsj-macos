+#[derive(Copy, Clone, Collect)]
+#[collect(no_drop)]
+pub(crate) struct ColdBitmapWeak<'gc>(GcWeak<'gc, RefLock<BitmapRawData<'gc>>>);
+
+impl<'gc> ColdBitmapWeak<'gc> {
+    pub(crate) fn is_dropped(self) -> bool {
+        self.0.is_dropped()
+    }
+
+    pub(crate) fn pack_if_idle(self, mc: &Mutation<'gc>) -> bool {
+        let Some(bitmap) = self.0.upgrade(mc) else {
+            return false;
+        };
+        let mut bitmap = bitmap.borrow_mut(mc);
+        if !matches!(bitmap.dirty_state, DirtyState::Clean)
+            || !matches!(bitmap.pixels.0.origin, PixelOrigin::Embedded)
+        {
+            return false;
+        }
+        bitmap.pixels.pack_if_idle()
+    }
+}
