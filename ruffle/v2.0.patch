+    /// Share identical decompressed data without changing the identity or metadata of the movie.
+    pub fn share_data(&mut self, pool: &mut Vec<std::sync::Weak<Vec<u8>>>) {
+        pool.retain(|entry| entry.strong_count() > 0);
+        for entry in pool.iter().rev() {
+            if let Some(data) = entry.upgrade()
+                && data.as_slice() == self.data.as_slice()
+            {
+                self.data = data;
+                return;
+            }
+        }
+        if pool.len() == 256 {
+            pool.remove(0);
+        }
+        pool.push(Arc::downgrade(&self.data));
+    }
