+thread_local! {
+    static EMBEDDED_PIXEL_CLASSES: RefCell<HashMap<usize, (String, WeakBitmapPixels)>> =
+        RefCell::new(HashMap::new());
+    static EMBEDDED_PIXEL_BUFFERS: RefCell<HashMap<u64, WeakBitmapPixels>> =
+        RefCell::new(HashMap::new());
+}
+
+impl BitmapPixels {
+    fn new(pixels: Vec<Color>, origin: PixelOrigin) -> Self {
+        Self(Arc::new(PixelBuffer::new(pixels, origin)))
+    }
+
+    pub(crate) fn from_embedded(pixels: Vec<Color>) -> Self {
+        const MIN_SHARED_PIXELS: usize = 16_384;
+        const MAX_SHARED_ENTRIES: usize = 4096;
+        if pixels.len() < MIN_SHARED_PIXELS {
+            return Self::new(pixels, PixelOrigin::Embedded);
+        }
+        let mut hash = DefaultHasher::new();
+        hash.write(Color::slice_as_rgba(&pixels));
+        let key = hash.finish();
+        EMBEDDED_PIXEL_BUFFERS.with_borrow_mut(|buffers| {
+            if let Some(existing) = buffers.get(&key).and_then(WeakBitmapPixels::upgrade)
+                && existing.0.raw.get().is_some_and(|raw| *raw == pixels)
+            {
+                return existing;
+            }
+            if buffers.len() == MAX_SHARED_ENTRIES {
+                buffers.retain(|_, value| value.0.strong_count() != 0);
+            }
+            let pixels = Self::new(pixels, PixelOrigin::Embedded);
+            if buffers.len() < MAX_SHARED_ENTRIES {
+                buffers.insert(key, pixels.downgrade());
+            }
+            pixels
+        })
+    }
+
+    pub(crate) fn record_embedded_class(&self, class: crate::avm2::QName<'_>) {
+        // The index keeps no GC objects or pixel data alive.
+        if self.capacity() < 16_384 {
+            return;
+        }
+        EMBEDDED_PIXEL_CLASSES.with_borrow_mut(|entries| {
+            let key = Arc::as_ptr(&self.0) as usize;
+            if entries.len() >= 4096 {
+                entries.retain(|_, (_, pixels)| pixels.0.strong_count() != 0);
+            }
+            if entries.len() < 4096 {
+                entries.entry(key).or_insert_with(|| {
+                    let name = class.local_name();
+                    (name.to_utf8_lossy().chars().take(120).collect(), self.downgrade())
+                });
+            }
+        });
+    }
+
+    pub(crate) fn downgrade(&self) -> WeakBitmapPixels {
+        WeakBitmapPixels(Arc::downgrade(&self.0))
+    }
+
+    fn capacity(&self) -> usize {
+        self.0.capacity()
+    }
+
+    fn pack_if_idle(&mut self) -> bool {
+        let buffer = &self.0;
+        if buffer.packing_rejected.load(Relaxed)
+            || Arc::strong_count(buffer) != 1
+            || PIXEL_CLOCK.get().saturating_sub(buffer.last_access.load(Relaxed)) < COLD_SECONDS
+            || !(MIN_COLD_PIXEL_BYTES..=MAX_COLD_PIXEL_BYTES)
+                .contains(&(buffer.capacity() * size_of::<Color>()))
+        {
+            return false;
+        }
+        let packed = buffer.packed.clone().or_else(|| {
+            PackedPixels::encode(buffer.raw.get().expect("Resident BitmapData")).map(Arc::new)
+        });
+        let Some(packed) = packed else {
+            // Do not repeatedly try to compress an unchanged buffer.
+            buffer.packing_rejected.store(true, Relaxed);
+            return true;
+        };
+        let old_key = Arc::as_ptr(buffer) as usize;
+        self.0 = Arc::new(PixelBuffer {
+            packed: Some(packed),
+            origin: PixelOrigin::Embedded,
+            last_access: AtomicUsize::new(PIXEL_CLOCK.get()),
+            raw: OnceLock::new(),
+            packing_rejected: AtomicBool::new(false),
+        });
+        EMBEDDED_PIXEL_CLASSES.with_borrow_mut(|entries| {
+            if let Some((name, _)) = entries.remove(&old_key) {
+                entries.insert(Arc::as_ptr(&self.0) as usize, (name, self.downgrade()));
+            }
+        });
+        true
+    }
+}
